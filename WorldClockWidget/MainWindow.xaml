<Window x:Class="WorldClockWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="World Clock Widget"
        Width="820" Height="320"
        MinWidth="480" MinHeight="220"
        ResizeMode="CanResizeWithGrip">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,8,10,8">
            <Button x:Name="PrevDayButton" Content="◀" Width="28" Click="PrevDayButton_Click"/>
            <TextBlock x:Name="DateLabel" Width="220" TextAlignment="Center" VerticalAlignment="Center" FontSize="14" Margin="4,0"/>
            <Button x:Name="NextDayButton" Content="▶" Width="28" Click="NextDayButton_Click"/>
            <Button x:Name="TodayButton" Content="Today" Margin="12,0,0,0" Click="TodayButton_Click"/>
            <Button x:Name="AddCityButton" Content="+ Add city" Margin="8,0,0,0" Click="AddCityButton_Click"/>
            <CheckBox x:Name="AlwaysOnTopCheckBox" Content="Always on top" Margin="16,0,0,0"
                      VerticalAlignment="Center"
                      Checked="AlwaysOnTopCheckBox_Changed" Unchecked="AlwaysOnTopCheckBox_Changed"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,4,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel x:Name="HeaderPanel" Grid.Column="0" Margin="10,0,0,0"/>

            <ScrollViewer x:Name="HourScrollViewer" Grid.Column="1"
                          HorizontalScrollBarVisibility="Visible"
                          VerticalScrollBarVisibility="Disabled"
                          PanningMode="HorizontalOnly">
                <Grid x:Name="HourGrid"/>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
